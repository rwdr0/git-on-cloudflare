{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-on-cloudflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "git.rwdr0.me",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO_DO",
        "class_name": "RepoDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RepoDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AuthDurableObject"
      ]
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "AuthDurableObject"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ROUTES",
      "id": "9829757c9f7741b1a8ba9a1bebf0b8f0"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-on-cloudflare",
      "database_id": "41848a13-5f84-46e6-bb06-a194a06711d7",
      "migrations_dir": "drizzle/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPO_BUCKET",
      "bucket_name": "git-repos"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REPO_TASKS_QUEUE",
        "queue": "git-on-cloudflare-repo-maint"
      }
    ],
    "consumers": [
      {
        "queue": "git-on-cloudflare-repo-maint",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "html_handling": "none"
  },
  // Environment variables (text/JSON)
  "vars": {
    // Repo DO idle cleanup threshold (minutes)
    "REPO_DO_IDLE_MINUTES": "30",
    // Logging level: debug|info|warn|error
    "LOG_LEVEL": "info",
    // tessera OIDC issuer (production). Override via .dev.vars for local dev.
    // Client id and secret are runtime concerns and live in .dev.vars / `wrangler secret put`.
    "TESSERA_OIDC_ISSUER": "https://auth.limic.dev"
  }
}
