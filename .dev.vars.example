# Local development values used by `wrangler types`.
# Copy this file to `.dev.vars` and replace placeholders as needed.

# Repo Durable Object idle cleanup threshold in minutes.
REPO_DO_IDLE_MINUTES=30

# Logging level: debug|info|warn|error.
LOG_LEVEL=debug

# Local goc browser session cookie sealing secret. Generate a real value with
# `openssl rand -hex 32`, then set production with
# `wrangler secret put SESSION_SECRET`; never commit a real production value.
SESSION_SECRET=local-goc-session-secret-change-me

# OIDC issuer override for local dev. The production issuer (a Cloudflare
# Access SaaS OIDC app) lives in wrangler.jsonc vars. Loopback HTTP is allowed
# for the issuer so a local OIDC provider can be used during development.
OIDC_ISSUER=http://localhost:5174

# OIDC client credentials. The client id is public and lives in
# wrangler.jsonc vars for production. The client secret must be set with
# `wrangler secret put OIDC_CLIENT_SECRET`; never commit a real value.
OIDC_CLIENT_ID=local-goc
OIDC_CLIENT_SECRET=local-goc-dev-secret-change-me
